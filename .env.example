# Only needed when the frontend and game server are hosted separately.
# Copy this file to .env and set the PUBLIC server URL, then rebuild.
# VITE_SERVER_URL=https://game.example.com
# Server PORT is a process environment variable (PowerShell: $env:PORT="2567").

# Enable debug controls only on a local development server (practice rooms).
# DEBUG_GAME=1
# Production ignores DEBUG_GAME even when set.
