{
  "name": "autochess-web-starter",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/engine.test.ts tests/skills.test.ts tests/shop.test.ts tests/bench.test.ts tests/sell.test.ts tests/progression.test.ts tests/snapshot.test.ts tests/match-rules.test.ts tests/debug.test.ts tests/merge.test.ts tests/interaction.test.ts tests/synergy.test.ts tests/rewards.test.ts tests/combat-shop.test.ts tests/swap.test.ts tests/history.test.ts tests/contributions.test.ts tests/results.test.ts tests/connection.test.ts tests/reward-popup.test.ts tests/screen-mode.test.ts tests/equipment-intent.test.ts tests/unit-inspection.test.ts tests/supply-actions.test.ts tests/empty-start.test.ts tests/board-geometry.test.ts tests/unit-motion.test.ts tests/damage-display.test.ts tests/health-trail.test.ts tests/skill-indicator.test.ts tests/unit-appearance.test.ts tests/scouting.test.ts tests/combat-damage.test.ts tests/attack-speed.test.ts tests/skill-presentation.test.ts tests/unit-pool.test.ts tests/matching.test.ts tests/room-code.test.ts tests/deferred-merge.test.ts tests/room-lifecycle.test.ts tests/minions.test.ts tests/bot-practice.test.ts tests/overtime.test.ts tests/refinements56.test.ts tests/expanded-catalog.test.ts tests/blue-archive.test.ts tests/local-practice.test.ts",
    "test:network": "node --import tsx --test tests/network.test.ts tests/debug.network.test.ts tests/rewards.network.test.ts tests/swap.network.test.ts tests/history.network.test.ts tests/results.network.test.ts tests/scouting-sale.network.test.ts tests/reconnection.network.test.ts tests/minions.network.test.ts tests/bot-practice.network.test.ts",
    "test:browser": "node tests/bench.browser.cjs",
    "dev:debug": "node scripts/dev-debug.mjs",
    "simulate": "node --import tsx scripts/simulate.ts",
    "test:rewards:browser": "node tests/rewards.browser.cjs",
    "test:swap:browser": "node tests/swap.browser.cjs",
    "test:history:browser": "node tests/history.browser.cjs",
    "test:results:browser": "node tests/results.browser.cjs",
    "test:reward-popup:browser": "node tests/rewards.browser.cjs",
    "test:screen-mode:browser": "node tests/screen-mode.browser.cjs",
    "test:board:browser": "node tests/board-geometry.browser.cjs",
    "setup:browser": "node scripts/setup-browser.cjs",
    "test:visual:browser": "node tests/visual.browser.cjs",
    "test:pc-dock:browser": "node tests/pc-dock.browser.cjs",
    "test:mobile-dock:browser": "node tests/mobile-dock.browser.cjs",
    "prestart": "npm run build",
    "test:dock-tabs:browser": "node tests/dock-tabs.browser.cjs",
    "test:equipment:browser": "node tests/equipment.browser.cjs",
    "test:inspection:browser": "node tests/unit-inspection.browser.cjs",
    "test:supply:browser": "node tests/supply-actions.browser.cjs",
    "test:home:browser": "node tests/home-page.browser.cjs",
    "test:empty-start:browser": "node tests/empty-start.browser.cjs",
    "test:gold-dock:browser": "node tests/gold-dock.browser.cjs",
    "test:reference-dock:browser": "node tests/reference-dock.browser.cjs",
    "test:separated-layout:browser": "node tests/separated-layout.browser.cjs",
    "test:synergy-panel:browser": "node tests/synergy-panel.browser.cjs",
    "test:help:browser": "npm run test:shop-preview:browser",
    "test:battle-review:browser": "node tests/battle-review.browser.cjs",
    "test:craft-workspace:browser": "node tests/craft-workspace.browser.cjs",
    "test:reward-inspection:browser": "node tests/reward-inspection.browser.cjs",
    "test:interface-refinements:browser": "node tests/interface-refinements.browser.cjs",
    "test:ranking:browser": "node tests/ranking.browser.cjs",
    "test:mobile-landscape:browser": "node tests/mobile-landscape.browser.cjs",
    "test:room-code:browser": "node tests/room-code.browser.cjs",
    "test:combat-attributes:browser": "node tests/combat-attributes.browser.cjs",
    "test:unit-motion": "node --import tsx --test tests/unit-motion.test.ts",
    "test:unit-motion:browser": "node tests/unit-motion.browser.cjs",
    "test:gun-effects:browser": "node tests/gun-effects.browser.cjs",
    "test:barrier:browser": "node tests/barrier-health.browser.cjs",
    "test:idle-skills:browser": "node tests/idle-skills.browser.cjs",
    "test:square-units:browser": "node tests/square-units.browser.cjs",
    "simulate:combat": "node --import tsx scripts/combat-balance.ts defense-critical",
    "test:combat-stats:browser": "node tests/combat-stats.browser.cjs",
    "test:shop-refresh:browser": "node tests/shop-refresh.browser.cjs",
    "test:unit-selection:browser": "node tests/unit-selection.browser.cjs",
    "test:combat-scouting:browser": "node tests/combat-scouting.browser.cjs",
    "test:skill-cards:browser": "npm run test:skill-details:browser",
    "test:selling-pool:browser": "node tests/selling-pool.browser.cjs",
    "test:pvp-matching:browser": "node tests/pvp-matching.browser.cjs",
    "test:deferred-merge:browser": "node tests/deferred-merge.browser.cjs",
    "test:reconnection:browser": "node tests/reconnection.browser.cjs",
    "test:minions:browser": "node tests/minions.browser.cjs",
    "test:bot-practice:browser": "node tests/bot-practice.browser.cjs",
    "test:refinements55:browser": "node tests/refinements55.browser.cjs",
    "test:refinements56:browser": "npm run test:synergy-presentation:browser",
    "test:synergy-presentation:browser": "node --import tsx tests/synergy-presentation.browser.cjs",
    "test:expanded-catalog:browser": "node --import tsx tests/expanded-catalog.browser.cjs",
    "test:combat-reserve-sale:browser": "node --import tsx tests/combat-reserve-sale.browser.cjs",
    "test:skill-details:browser": "node --import tsx tests/skill-details.browser.cjs",
    "test:shop-preview:browser": "node --import tsx tests/shop-preview.browser.cjs",
    "test:blue-archive:browser": "node tests/blue-archive.browser.cjs",
    "build:pages": "npm run check && vite build --mode pages",
    "test:pages:browser": "node tests/pages.browser.cjs",
    "publish:pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "@colyseus/core": "~0.16.0",
    "@colyseus/ws-transport": "~0.16.0",
    "colyseus.js": "~0.16.0",
    "express": "^4.21.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
